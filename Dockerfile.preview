FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system site && useradd --system --gid site --home-dir /app site

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=site:site . /app
RUN mkdir -p /data && chown site:site /data

USER site
EXPOSE 8000

# This is a LOCAL PREVIEW image only. Never expose port 8000 to the internet.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
