{
    email {$ACME_EMAIL}
}
{$SITE_DOMAIN} {
    encode zstd gzip
    @media path /media/*
    handle @media {
        root * /srv
        header X-Content-Type-Options "nosniff"
        header Content-Security-Policy "default-src 'none'; sandbox"
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
