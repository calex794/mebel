# For local development only. Do not commit the real .env file.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-random-secret-for-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# For deployment behind HTTPS:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.ru
# DJANGO_SECURE_PROXY_SSL_HEADER=1

# SQLite is the default for a local start.
# For PostgreSQL, uncomment:
# DB_ENGINE=postgres
# DB_NAME=mebel
# DB_USER=mebel
# DB_PASSWORD=...
# DB_HOST=127.0.0.1
# DB_PORT=5432
